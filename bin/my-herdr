#!/usr/bin/env python3
"""Entry point for every my-herdr action and pane entrypoint.

herdr runs this with the plugin root as cwd, but a pane opened with --cwd does
not, so the package is located relative to this file (symlinks resolved) rather
than relative to the working directory.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from myherdr.cli import main  # noqa: E402  (path setup has to come first)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
